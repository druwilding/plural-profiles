!!!
%html{lang: "en-GB"}
  = render "layouts/head"

  %body{style: active_theme_style, data: {controller: "timezone"}}
    %header.site-header
      .site-header__brand
        = link_to root_path, class: "logo" do
          = render "shared/plural_pride_logo"
          Plural Profiles
        = render "shared/domain_switcher"
      %nav
        - if authenticated?
          = link_to "Groups", our_groups_path
          = link_to "New group", new_our_group_path
          = link_to "Profiles", our_profiles_path
          = link_to "New profile", new_our_profile_path
          = link_to "Themes", our_themes_path
          -# No prefetch: hovering would otherwise ask Dreamwidth for a journal's
          -# entries before anyone clicked.
          = link_to "Journal", journal_root_path, aria: { current: ("page" if controller_path.start_with?("journal/")) }, data: { turbo_prefetch: "false" }
          - if Current.user&.admin?
            = link_to "Admin", admin_root_path
          -# Signing out clears this account's journal drafts (journal_drafts.js).
          = link_to "Sign out", session_path, data: { turbo_method: :delete, controller: "journal-sign-out",
            "journal-sign-out-user-value": Current.user.id, action: "journal-sign-out#clearDrafts" }
        - else
          = link_to "Sign in", new_session_path
          = link_to "Sign up", new_registration_path

    %main{class: "container #{content_for(:container_class)}", data: {controller: "spoiler", action: "click->spoiler#toggle keydown->spoiler#keydown"}}
      - if @sidebar_trees
        .layout{class: ("layout--sidebar-hidden" if sidebar_hidden?), data: { controller: "sidebar-toggle", "sidebar-toggle-cookie-value": "sidebar", "sidebar-toggle-hidden-class": "layout--sidebar-hidden" }}
          = render "our/sidebar"
          = render "shared/sidebar_toggle_button", action: :show, controls: "sidebar"
          .main-content
            - unless inline_flash?
              - if flash[:notice]
                .flash.flash--notice= flash[:notice]
              - if flash[:alert]
                .flash.flash--alert= flash[:alert]
            = yield
      - else
        - unless inline_flash?
          - if flash[:notice]
            .flash.flash--notice= flash[:notice]
          - if flash[:alert]
            .flash.flash--alert= flash[:alert]
        = yield
    = yield :footer
    -# In the body, not the head: Turbo replaces the body on every visit, but
    -# never removes old head scripts, so a head copy would go stale.
    = emote_list_json_tag
