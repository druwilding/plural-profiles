!!!
%html{lang: "en-GB"}
  = render "layouts/head"

  %body{style: active_theme_style, data: {controller: "timezone"}}
    %header.site-header
      .site-header__brand
        = link_to root_path, class: "logo" do
          = render "shared/plural_pride_logo"
          Plural Profiles
        = render "shared/domain_switcher"
      %nav
        - if authenticated?
          = link_to "Groups", our_groups_path
          = link_to "New group", new_our_group_path
          = link_to "Profiles", our_profiles_path
          = link_to "New profile", new_our_profile_path
          = link_to "Themes", our_themes_path
          - if Current.user&.admin?
            = link_to "Admin", admin_root_path
          = link_to "Sign out", session_path, data: { turbo_method: :delete }
        - else
          = link_to "Sign in", new_session_path
          = link_to "Sign up", new_registration_path

    %main{class: "container #{content_for(:container_class)}", data: {controller: "spoiler", action: "click->spoiler#toggle keydown->spoiler#keydown"}}
      - if @sidebar_trees
        .layout{class: ("layout--sidebar-hidden" if sidebar_hidden?), data: { controller: "sidebar-toggle" }}
          = render "our/sidebar"
          %button.btn--secondary.sidebar-toggle.sidebar-toggle--show{type: "button", title: "Show sidebar", hidden: !sidebar_hidden?, "aria-controls": "sidebar", "aria-expanded": "false", data: { "sidebar-toggle-target": "showButton", action: "sidebar-toggle#show" }}
            %svg{viewBox: "0 0 24 24", width: 18, height: 18, fill: "none", stroke: "currentColor", "stroke-width": 2.5, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false"}
              %path{d: "M5 6l6 6-6 6M13 6l6 6-6 6"}
            %span.visually-hidden Show sidebar
          .main-content
            - if flash[:notice]
              .flash.flash--notice= flash[:notice]
            - if flash[:alert]
              .flash.flash--alert= flash[:alert]
            = yield
      - else
        - if flash[:notice]
          .flash.flash--notice= flash[:notice]
        - if flash[:alert]
          .flash.flash--alert= flash[:alert]
        = yield
    = yield :footer
    -# In the body, not the head: Turbo replaces the body on every visit, but
    -# never removes old head scripts, so a head copy would go stale.
    = emote_list_json_tag
