- content_for(:title) { "Themes — Plural Profiles" }

.card
  .card__header
    %h1 Themes

  .theme-heading__bar
    .theme-heading__active
      - if @active_theme
        %span.theme-heading__active-label
          Active theme:
          %strong= link_to @active_theme.name, our_theme_path(@active_theme)
        = link_to "Deactivate", deactivate_our_themes_path, data: { turbo_method: :patch }, class: "btn btn--small btn--secondary"
      - else
        %span.theme-heading__active-label No active theme — using site default.

    .theme-heading__actions{data: { controller: "theme-import", "theme-import-new-url-value": new_our_theme_path }}
      = link_to "New theme", new_our_theme_path, class: "btn"
      %button.btn.btn--outline{type: "button", data: { action: "click->theme-import#open" }} Import theme

      %dialog.import-dialog{data: { "theme-import-target": "dialog", action: "click->theme-import#backdropClick" }}
        %form{data: { action: "submit->theme-import#import" }}
          %h2 Import theme
          %p Paste a theme JSON export below (or a legacy CSS block).
          -# Version comes from the constant so the example can't go stale the next
          -# time the export format is bumped. Older exports still import fine.
          - import_example = "{\n  \"plural_profiles_theme\": #{Theme::CURRENT_EXPORT_VERSION},\n  \"name\": \"My theme\",\n  \"colors\": { ... }\n}"
          %textarea.import-dialog__textarea{data: { "theme-import-target": "cssInput" }, rows: 12, placeholder: import_example, spellcheck: false}
          %p.import-dialog__error{data: { "theme-import-target": "error" }, role: "alert"}
          .import-dialog__actions
            %button.btn{type: "submit"} Import
            %button.btn.btn--secondary{type: "button", data: { action: "click->theme-import#close" }} Cancel

- if @our_themes.any? || @any_shared_themes || @filter_tags.any?
  .card
    .card__header
      %h2 Filter themes
    .filter-bar
      - Theme::TAGS.each do |value, label|
        - active = @filter_tags.include?(value)
        - new_tags = active ? @filter_tags - [value] : @filter_tags + [value]
        = link_to label, our_themes_path(tags: new_tags), class: "tag tag--filter #{active ? ' tag--filter-active' : ''}"
      - if @filter_tags.any?
        = link_to "Clear filter", our_themes_path, class: "filter-bar__clear"

%details.card.theme-section-card{open: true, data: { controller: "details-persist", "details-persist-key-value": "our-themes" }}
  %summary.card__header.theme-section-card__header
    %h2 Our themes

  - if @our_themes.any?
    .theme-list
      - @our_themes.each do |theme|
        = render "our/themes/theme_row", theme: theme, section: "our"
  - elsif @filter_tags.any?
    %p.theme-section-card__empty No themes match the selected tags.
  - elsif @active_theme.nil?
    %p.theme-section-card__empty You haven't created any themes yet. Create one to customise your colours.

- if @any_shared_themes
  %details.card.theme-section-card{open: true, data: { controller: "details-persist", "details-persist-key-value": "shared-themes" }}
    %summary.card__header.theme-section-card__header
      %h2 Shared themes

    - if @shared_themes.any?
      .theme-list
        - @shared_themes.each do |theme|
          = render "our/themes/theme_row", theme: theme, section: "shared"
    - elsif @filter_tags.any?
      %p.theme-section-card__empty No shared themes match the selected tags.
