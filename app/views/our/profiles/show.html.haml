- content_for(:title) { plain_field(@profile.name) + " — Plural Profiles" }

.card
  .card__header
    - if @profile.avatar.attached?
      = link_to rails_blob_path(@profile.avatar, disposition: "inline"), target: "_blank", rel: "noopener", title: "Click to see full size" do
        = image_tag @profile.avatar.variant(resize_to_fill: [96, 96]), class: "avatar avatar--large #{avatar_shape_class(@profile)}".strip, width: 96, height: 96, alt: @profile.avatar_alt_text.presence || "", loading: "lazy"
    - else
      .avatar.avatar--large.avatar--placeholder
        = render "shared/plural_pride_logo"

    %div
      .name-with-labels
        %h1= formatted_inline(@profile.name)
        - if @profile.labels.any?
          .label-badges
            - @profile.labels.each do |label|
              %span.label-badge= label

      - if @profile.subtitle.present?
        %p.subtitle= formatted_inline(@profile.subtitle)

      - if @profile.pronouns.present? || @profile.heart_emojis.any?
        .pronouns
          - if @profile.pronouns.present?
            %span= formatted_inline(@profile.pronouns)
          - if @profile.heart_emojis.any?
            = render "shared/heart_list", hearts: @profile.heart_emojis

    - if @profile.tag_line.present?
      %p.tag-line= formatted_inline(@profile.tag_line)

  - if @profile.description.present?
    .profile-description
      = formatted_description(@profile.description)

  - profile_groups = @profile.groups.order_by_name_and_labels
  - if profile_groups.any?
    %h2 In groups
    %ul
      - profile_groups.each do |group|
        %li
          = link_to our_group_path(group) do
            = formatted_inline(group.name)
          - if group.labels.any?
            - group.labels.each do |label|
              %span.label-badge.label-badge--inline= label
          - if group.subtitle.present?
            %span.group-list-subtitle= formatted_inline(group.subtitle)

  .metadata
    - if @profile.chat_bracket_before.present? || @profile.chat_bracket_after.present?
      %p.profile-chat-proxy
        %strong Chat proxy brackets:
        %code= [ @profile.chat_bracket_before, "message", @profile.chat_bracket_after ].compact_blank.join(" ")
    %p
      %strong Created:
      %time{datetime: @profile.created_at.iso8601}= @profile.created_at.strftime("%d %B %Y")
      %span.time-ago= "(#{relative_time(@profile.created_at)})"
    %p
      %strong Updated:
      %time{datetime: @profile.updated_at.iso8601}= @profile.updated_at.strftime("%d %B %Y")
      %span.time-ago= "(#{relative_time(@profile.updated_at)})"

  .profile-actions
    = link_to "Edit", edit_our_profile_path(@profile), class: "btn btn--secondary"
    = link_to "Edit chat settings", edit_our_chat_identity_path(@profile.class.name, @profile.uuid), class: "btn btn--secondary"
    = link_to "Delete", our_profile_path(@profile), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn--danger"

.card
  .card__header
    %h2 Share this profile

  .share-url{data: {controller: "clipboard"}}
    %input{type: "text", value: profile_url(@profile.uuid), readonly: true, id: "profile-share-url", data: {"clipboard-target": "source"}}
    %button.btn{data: {action: "click->clipboard#copy"}}
      %span{data: {"clipboard-target": "label"}} Copy
      %span{aria: {hidden: "true"}} ⧉
    = link_to profile_url(@profile.uuid), target: "_blank", rel: "noopener", class: "btn btn--secondary" do
      Open
      %span{aria: {hidden: "true"}} ↗
  %p.share-url-hint
    You can regenerate this URL if you want a new one, for example, if you've shared it with someone and no longer want them to be able to see this profile.
    = link_to "Regenerate URL", regenerate_uuid_our_profile_path(@profile), data: { turbo_method: :patch, turbo_confirm: "This will break any existing links to this profile. Are you sure?" }, class: "btn btn--outline btn--small btn--danger"
