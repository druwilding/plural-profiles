- if profile.errors.any?
  .error-messages
    - profile.errors.full_messages.each do |message|
      %p= message

= form_with model: profile, url: profile.persisted? ? our_profile_path(profile) : our_profiles_path do |form|
  - if @return_to.present?
    = hidden_field_tag :return_to, @return_to

  .form-group
    = render "shared/avatar_editor_dialog", record: profile, form: form, param_prefix: "profile"

  .form-group
    = form.label :name
    = emote_field(form, :name, required: true, "data-1p-ignore": "true")

  .form-group
    = form.label :subtitle
    = emote_field(form, :subtitle)

  .form-group
    = form.label :pronouns
    = emote_field(form, :pronouns)

  .form-group
    = form.label :tag_line
    = emote_field(form, :tag_line)

  .form-group
    = form.label :emotes
    = emote_field(form, :emotes, "aria-describedby": "profile_emotes_hint")
    %p.form-hint#profile_emotes_hint Type codes like :spring-heart: or use the button to select emotes.

  .form-group
    = form.label :description
    = emote_field(form, :description, as: :text_area, rows: 18)

  - if @groups.any?
    %fieldset.form-group
      %legend Groups
      .checkbox-list
        = hidden_field_tag "profile[group_ids][]", ""
        - @groups.each do |group|
          %label.checkbox-label
            = check_box_tag "profile[group_ids][]", group.id, profile.group_ids.include?(group.id), id: "profile_group_ids_#{group.id}"
            %span.checkbox-label__text
              %span= formatted_inline(group.name)
              - if group.labels.any?
                - group.labels.each do |label|
                  %span.label-badge.label-badge--inline= label
              - if group.subtitle.present?
                %span.checkbox-label__subtitle= formatted_inline(group.subtitle)

  .form-group
    = form.label :labels_text, "Labels (optional, comma-separated)"
    = form.text_field :labels_text, value: profile.labels_text, placeholder: "e.g. safe, work, close friends"
    %p.form-hint Labels are only visible to you, they never appear on shared pages.

  .form-group
    = form.label :theme_id, "Display theme"
    = form.select :theme_id, grouped_options_for_select(grouped_theme_options(@personal_themes, @shared_themes), profile.theme_id), { include_blank: "None (use default)" }, {}
    %p.form-hint Visitors to this profile's page will see this theme. Leave blank for the site default.

  - if profile.persisted?
    .form-group
      = form.label :created_at
      = render "shared/datetime_picker", form: form, field: :created_at, value: profile.created_at

  .form-group
    = form.submit profile.persisted? ? "Update profile" : "Create profile"
    = link_to "Cancel", profile.persisted? ? our_profile_path(profile) : our_profiles_path, class: "btn btn--secondary"
