- content_for(:title) { plain_field(@group.name) + " — Plural Profiles" }

.card
  .card__header
    - if @group.avatar.attached?
      = link_to rails_blob_path(@group.avatar, disposition: "inline"), target: "_blank", rel: "noopener", title: "Click to see full size" do
        = image_tag @group.avatar.variant(resize_to_fill: [96, 96]), class: "avatar avatar--large #{avatar_shape_class(@group)}".strip, width: 96, height: 96, alt: @group.avatar_alt_text.presence || "", loading: "lazy"

    %div
      .name-with-labels
        %h1= formatted_inline(@group.name)
        - if @group.labels.any?
          .label-badges
            - @group.labels.each do |label|
              %span.label-badge= label

      - if @group.subtitle.present?
        %p.subtitle= formatted_inline(@group.subtitle)

      - if @group.pronouns.present? || @group.emotes.present?
        .pronouns
          - if @group.pronouns.present?
            %span= formatted_inline(@group.pronouns)
          - if @group.emotes.present?
            %span.pronouns__emotes= formatted_inline(@group.emotes)

    - if @group.tag_line.present?
      %p.tag-line= formatted_inline(@group.tag_line)

  %div
    - if @group.description.present?
      .group-description
        = formatted_description(@group.description)

  - parent_groups = @group.parent_groups.order_by_name_and_labels
  - if parent_groups.any?
    %h2 In groups
    %ul
      - parent_groups.each do |parent|
        %li
          = link_to our_group_path(parent) do
            = formatted_inline(parent.name)
          - if parent.labels.any?
            - parent.labels.each do |label|
              %span.label-badge.label-badge--inline= label
          - if parent.subtitle.present?
            %span.group-list-subtitle= formatted_inline(parent.subtitle)

  .metadata
    %p
      %strong Created:
      %time{datetime: @group.created_at.iso8601}= @group.created_at.strftime("%d %B %Y")
      %span.time-ago= "(#{relative_time(@group.created_at)})"
    %p
      %strong Updated:
      %time{datetime: @group.updated_at.iso8601}= @group.updated_at.strftime("%d %B %Y")
      %span.time-ago= "(#{relative_time(@group.updated_at)})"

  .profile-actions
    = link_to "Edit", edit_our_group_path(@group), class: "btn btn--secondary"
    = link_to "Edit chat settings", edit_our_chat_identity_path(@group.class.name, @group.uuid), class: "btn btn--secondary"
    = link_to "Manage groups", manage_groups_our_group_path(@group), class: "btn btn--secondary"
    = link_to "Manage profiles", manage_profiles_our_group_path(@group), class: "btn btn--secondary"
    = link_to "Duplicate", duplicate_our_group_path(@group), class: "btn btn--secondary"
    = link_to "Delete", our_group_path(@group), data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will only delete the group and its relationships, not the profiles or child groups themselves." }, class: "btn btn--danger"

.card
  .card__header
    %h2 Share this group

  .share-url{data: {controller: "clipboard"}}
    %input{type: "text", value: group_url(@group.uuid), readonly: true, id: "group-share-url", data: {"clipboard-target": "source"}}
    %button.btn{data: {action: "click->clipboard#copy"}}
      %span{data: {"clipboard-target": "label"}} Copy
      %span{aria: {hidden: "true"}} ⧉
    = link_to group_url(@group.uuid), target: "_blank", rel: "noopener", class: "btn btn--secondary" do
      Open
      %span{aria: {hidden: "true"}} ↗
  %p.share-url-hint
    You can regenerate this URL if you want a new one, for example, if you've shared it with someone and no longer want them to be able to see this group.
    = link_to "Regenerate URL", regenerate_uuid_our_group_path(@group), data: { turbo_method: :patch, turbo_confirm: "This will break any existing links to this group. Are you sure?" }, class: "btn btn--outline btn--small btn--danger"

- if @group.child_groups.any?
  .profile-grid
    - @group.child_groups.order_by_name_and_labels.each do |child|
      = render "group_card", group: child

- if @group.profiles.any?
  .profile-grid
    - @group.profiles.order_by_name_and_labels.each do |profile|
      = render "our/profiles/profile_card", profile: profile
