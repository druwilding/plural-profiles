- if group.errors.any?
  .error-messages
    - group.errors.full_messages.each do |message|
      %p= message

= form_with model: group, url: group.persisted? ? our_group_path(group) : our_groups_path do |form|
  .form-group
    = render "shared/avatar_editor_dialog", record: group, form: form, param_prefix: "group"

  .form-group
    = form.label :name
    = heart_field(form, :name, required: true, "data-1p-ignore": "true")

  .form-group
    = form.label :subtitle
    = heart_field(form, :subtitle)

  .form-group
    = form.label :pronouns
    = heart_field(form, :pronouns)

  .form-group
    = form.label :tag_line
    = heart_field(form, :tag_line)

  .form-group
    = form.label :description
    = heart_field(form, :description, as: :text_area, rows: 18)

  .form-group
    = form.label :labels_text, "Labels (optional, comma-separated)"
    = form.text_field :labels_text, value: group.labels_text, placeholder: "e.g. safe, work, close friends"
    %p.form-hint Labels are only visible to you, they never appear on shared pages.

  .form-group
    = form.label :theme_id, "Display theme"
    = form.select :theme_id, grouped_options_for_select(grouped_theme_options(@our_themes, @shared_themes), group.theme_id), { include_blank: "None (use default)" }, {}
    %p.form-hint Visitors to this group's page will see this theme. Leave blank for the site default.

  - if group.persisted?
    .form-group
      = form.label :created_at
      = render "shared/datetime_picker", form: form, field: :created_at, value: group.created_at

  .form-group
    = form.submit group.persisted? ? "Update group" : "Create group"
    = link_to "Cancel", group.persisted? ? our_group_path(group) : our_groups_path, class: "btn btn--secondary"
