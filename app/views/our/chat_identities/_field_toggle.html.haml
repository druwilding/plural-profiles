-# Locals:
-#   form             — the chat_identity form builder
-#   field            — base field name, e.g. :subtitle (drives
-#                      mini_profile_<field> / mini_profile_<field>_inherited)
-#   label            — human label for the card title, e.g. "Subtitle"
-#   inherited_value  — the live main value to show when using it, already
-#                      formatted (formatted_inline/formatted_description)
-#                      and html_safe, or blank
-#   hint             — (optional) hint text shown under the title
-#   input_type       — (optional, default :text_field) :text_field or
-#                      :text_area, whichever form builder method edits the
-#                      override value (wrapped by heart_field, so it gets
-#                      the heart picker button and autocomplete)
-#   placeholder      — (optional) placeholder for the override input
-#   override_hint    — (optional) replaces the default "Leave blank to hide
-#                      this from chat." hint under the override input —
-#                      name uses this, since it can't be left blank
-#
-# `role="group"`/`aria-labelledby` stands in for `<fieldset>`/`<legend>`
-# here — a real legend can't sit inline next to the toggle control the way
-# the card header layout needs, but this keeps the same "these radios
-# belong to this label" semantics for assistive tech.
-#
-# `chat_identity_form_controller.js` shows/hides the "currently on X" and
-# override blocks based on which radio is checked (see syncCard) — both
-# render server-side regardless, so the page still works without JS.

- inherited_field = :"mini_profile_#{field}_inherited"
- override_field = :"mini_profile_#{field}"
- input_type = local_assigns[:input_type] || :text_field
- title_id = "chat-identity-field-#{field}-title"

.card.chat-identity-field{role: "group", "aria-labelledby": title_id}
  .chat-identity-field__head
    %div
      %h3{id: title_id}= label
      - if local_assigns[:hint]
        %p.form-hint= hint
    .chat-identity-toggle
      %label.chat-identity-toggle__option
        = form.radio_button inherited_field, true, class: "chat-identity-toggle__input"
        %span.chat-identity-toggle__option-label Use main
      %label.chat-identity-toggle__option
        = form.radio_button inherited_field, false, class: "chat-identity-toggle__input"
        %span.chat-identity-toggle__option-label Set for chat

  .chat-identity-field__inherited
    - if inherited_value.present?
      .chat-identity-field__value= inherited_value
    - else
      %span.chat-identity-field__blank (nothing set)

  .chat-identity-field__override
    = heart_field(form, override_field, as: input_type, placeholder: local_assigns[:placeholder])
    %p.form-hint= local_assigns[:override_hint] || "Leave blank to hide this from chat."
