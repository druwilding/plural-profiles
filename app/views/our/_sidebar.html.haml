-# The wrapper, not the nav, is what's hidden and what sticks as the page
-# scrolls (see sidebar_toggle_controller.js), so the hide button can overlap the nav's edge without being
-# clipped by its scrolling.
.sidebar-wrap{data: { controller: "sidebar-reorder", "sidebar-reorder-url-value": our_ordering_path }}
  = render "shared/sidebar_toggle_button", action: :hide, controls: "sidebar"
  -# Switches reorder mode (sidebar_reorder_controller.js) on and off. It sits
  -# beside the hide button in the same round style, and shows a tick while
  -# reordering. Like the hide button, it needs JavaScript, so it only shows
  -# under html.js.
  %button.btn--secondary.sidebar-toggle.sidebar-reorder-toggle{type: "button", title: "Reorder groups and profiles", "aria-pressed": "false", "aria-describedby": "sidebar-reorder-hint", data: { "sidebar-reorder-target": "toggle", action: "sidebar-reorder#toggle" }}
    %svg.sidebar-reorder-toggle__start{viewBox: "0 0 24 24", width: 18, height: 18, fill: "none", stroke: "currentColor", "stroke-width": 2.5, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false"}
      %path{d: "M8 20V4M4 8l4-4 4 4M16 4v16M12 16l4 4 4-4"}
    %svg.sidebar-reorder-toggle__done{viewBox: "0 0 24 24", width: 18, height: 18, fill: "none", stroke: "currentColor", "stroke-width": 2.5, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true", focusable: "false"}
      %path{d: "M5 12.5l4.5 4.5L19 7"}
    %span.visually-hidden Reorder groups and profiles
  %nav.sidebar#sidebar{"aria-label" => "Your content"}
    = form_with url: our_search_path, method: :get, class: "sidebar__search" do |form|
      = form.text_field :q, type: "search", value: params[:q], placeholder: "Search...", "aria-label": "Search your groups and profiles"

    -# Shown while reordering, under the search box
    .sidebar__reorder
      %p.sidebar__reorder-hint#sidebar-reorder-hint{hidden: true, data: { "sidebar-reorder-target": "hint" }}
        Drag the handles to move things within their own list. With a keyboard, use the arrow keys on a handle.
      %span.visually-hidden#sidebar-reorder-keys Use the up and down arrow keys to move it.
      %p.sidebar__reorder-error{role: "alert", data: { "sidebar-reorder-target": "error" }}
      .visually-hidden{"aria-live": "polite", data: { "sidebar-reorder-target": "status" }}

    %hr

    %details{open: true, data: { controller: "details-persist sidebar-tree-controls", "details-persist-key-value": "sidebar-groups" }}
      %summary Groups
      - if @sidebar_trees.any?
        .sidebar-tree__controls
          %button.sidebar-tree__control-btn{type: "button", data: { action: "sidebar-tree-controls#expandAll" }} Expand all
          %button.sidebar-tree__control-btn{type: "button", data: { action: "sidebar-tree-controls#collapseAll" }} Collapse all
          %button.sidebar-tree__control-btn.reorder-only{type: "button", data: { action: "sidebar-reorder#reset", "reorder-reset": "groups", "reorder-within": "Groups" }} Sort A–Z
      %ul.sidebar-tree
        - @sidebar_trees.each do |node|
          = render "our/sidebar_tree_node", node: node

    %hr

    %details{open: true, data: { controller: "details-persist", "details-persist-key-value": "sidebar-profiles" }}
      %summary Profiles
      - if @sidebar_all_profiles.many?
        .sidebar-tree__controls.reorder-only
          %button.sidebar-tree__control-btn{type: "button", data: { action: "sidebar-reorder#reset", "reorder-reset": "profiles", "reorder-within": "Profiles" }} Sort A–Z
      %ul.sidebar-tree
        - @sidebar_all_profiles.each do |profile|
          %li.sidebar-tree__leaf{class: ("sidebar-tree__leaf--active" if @profile && @profile.id == profile.id), data: reorder_item_data(profile, list: "profiles", within: "Profiles")}
            - if profile.avatar.attached?
              = image_tag profile.avatar.variant(resize_to_fill: [24, 24]), class: "sidebar-tree__avatar #{avatar_shape_class(profile, prefix: 'sidebar-tree__avatar')}".strip, width: 24, height: 24, alt: profile.avatar_alt_text.presence || "", loading: "lazy"
            - else
              %span.sidebar-tree__avatar.sidebar-tree__avatar--placeholder
                = render "shared/plural_pride_logo"
            = link_to our_profile_path(profile), class: "sidebar-tree__link" do
              %span.sidebar-tree__label= formatted_inline(profile.name)
              - if profile.subtitle.present?
                %span.sidebar-tree__subtitle= formatted_inline(profile.subtitle)
            - profile.labels.each do |label|
              %span.label-badge.label-badge--sidebar= label

    %hr

    %ul.sidebar__list
      %li{class: "sidebar__item #{('sidebar__item--active' if current_page?(our_themes_path))}"}
        = link_to "Themes", our_themes_path, class: "sidebar__link"
      %li{class: "sidebar__item #{('sidebar__item--active' if current_page?(our_account_path))}"}
        = link_to "Account", our_account_path, class: "sidebar__link"
      - if Current.user&.admin?
        %li{class: "sidebar__item #{('sidebar__item--active' if controller_path.start_with?('admin/'))}"}
          = link_to "Admin", admin_root_path, class: "sidebar__link"
