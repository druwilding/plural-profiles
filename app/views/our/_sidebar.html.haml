%nav.sidebar{"aria-label" => "Your content"}
  = form_with url: our_search_path, method: :get, class: "sidebar__search" do |form|
    = form.text_field :q, type: "search", value: params[:q], placeholder: "Search...", "aria-label": "Search your groups and profiles"

  %hr

  %details{open: true, data: { controller: "details-persist sidebar-tree-controls", "details-persist-key-value": "sidebar-groups" }}
    %summary Groups
    - if @sidebar_trees.any?
      .sidebar-tree__controls
        %button.sidebar-tree__control-btn{type: "button", data: { action: "sidebar-tree-controls#expandAll" }} Expand all
        %button.sidebar-tree__control-btn{type: "button", data: { action: "sidebar-tree-controls#collapseAll" }} Collapse all
    %ul.sidebar-tree
      - @sidebar_trees.each do |node|
        = render "our/sidebar_tree_node", node: node

  %hr

  %details{open: true, data: { controller: "details-persist", "details-persist-key-value": "sidebar-profiles" }}
    %summary Profiles
    %ul.sidebar-tree
      - @sidebar_all_profiles.each do |profile|
        %li.sidebar-tree__leaf{class: ("sidebar-tree__leaf--active" if @profile && @profile.id == profile.id)}
          - if profile.avatar.attached?
            = image_tag profile.avatar.variant(resize_to_fill: [24, 24]), class: "sidebar-tree__avatar #{avatar_shape_class(profile, prefix: 'sidebar-tree__avatar')}".strip, width: 24, height: 24, alt: profile.avatar_alt_text.presence || "", loading: "lazy"
          - else
            %span.sidebar-tree__avatar.sidebar-tree__avatar--placeholder
              = render "shared/plural_pride_logo"
          = link_to our_profile_path(profile), class: "sidebar-tree__link" do
            %span.sidebar-tree__label= formatted_inline(profile.name)
            - if profile.subtitle.present?
              %span.sidebar-tree__subtitle= formatted_inline(profile.subtitle)
          - profile.labels.each do |label|
            %span.label-badge.label-badge--sidebar= label

  %hr

  %ul.sidebar__list
    %li{class: "sidebar__item #{('sidebar__item--active' if current_page?(our_themes_path))}"}
      = link_to "Themes", our_themes_path, class: "sidebar__link"
    %li{class: "sidebar__item #{('sidebar__item--active' if current_page?(our_account_path))}"}
      = link_to "Account", our_account_path, class: "sidebar__link"
    - if Current.user&.admin?
      %li{class: "sidebar__item #{('sidebar__item--active' if controller_path.start_with?('admin/'))}"}
        = link_to "Admin", admin_root_path, class: "sidebar__link"
