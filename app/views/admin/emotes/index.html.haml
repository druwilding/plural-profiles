- content_for(:title) { "Emotes — Plural Profiles" }

= render "admin/breadcrumbs", current: "Emotes"

.card
  .card__header
    %h1 Emotes
  .admin-emotes__intro
    %p
      An emote's name sets its order in its set: #{tag.code("02-spring-heart")} comes before #{tag.code("03-hunter-heart")}.
      The code people type drops that number, so #{tag.code("02-spring-heart")} is typed as #{tag.code(":spring-heart:")}
      (typing the full name works too).
    %p
      Renaming an emote keeps its old code working, so nothing already written breaks.
      Archiving hides an emote from pickers but keeps it showing wherever it's already used.
  .card__actions
    = link_to "Manage sets", admin_emote_sets_path, class: "btn btn--secondary"

%section.card{"aria-labelledby": "emote-upload-heading"}
  .card__header
    %h2#emote-upload-heading Upload emotes
  .admin-emotes__intro
    %p
      Choose PNG, WebP or SVG files, one or many. Each file's name becomes the emote's name, so
      #{tag.code("02 Spring Heart.png")} becomes #{tag.code("02-spring-heart")}.
      Files are added straight away. If a name is already in use, you'll be asked what to do with that file.
    %p.admin-emotes__hint
      Up to #{EmoteUpload::MAX_FILES} files at a time, #{EmoteUpload::MAX_FILE_SIZE / 1.megabyte} MB each.
      SVGs are converted to PNG in your browser before uploading.

  -# A plain (non-Turbo) submit: when files need a decision, that page is rendered straight from this POST.
  = form_with url: upload_admin_emotes_path, multipart: true, data: { turbo: false, controller: "emote-upload", action: "submit->emote-upload#submit" } do |form|
    .form-group
      .emote-upload__dropzone{data: { "emote-upload-target": "dropzone", action: "dragover->emote-upload#dragOver dragleave->emote-upload#dragLeave drop->emote-upload#drop" }}
        = form.label :files, "Images"
        = form.file_field :files, multiple: true, required: true, accept: ".png,.webp,.svg,image/png,image/webp,image/svg+xml",
          data: { "emote-upload-target": "input", action: "change->emote-upload#convert" }
        %p.emote-upload__hint Or drop files anywhere in this box.
      %p.emote-upload__status{role: "status", data: { "emote-upload-target": "status" }}

    .form-group
      = form.label :emote_set_id, "Add them to this set"
      = form.select :emote_set_id, @emote_sets.map { |emote_set| [ emote_set.name, emote_set.id ] }

    = form.submit "Upload", class: "btn", data: { "emote-upload-target": "submit" }

%section.card{"aria-labelledby": "emote-list-heading", data: { controller: "emote-filter preserve-focus" }}
  .card__header
    %h2#emote-list-heading All emotes
  .admin-emotes__toolbar
    %label.admin-emotes__filter
      %span Filter
      %input{type: "search", placeholder: "Name or code", autocomplete: "off", data: { "emote-filter-target": "input", action: "input->emote-filter#filter" }}
    %p#emote-status.admin-emotes__status{role: "status"}
  = render "admin/emotes/sections"
