-# A row of heart images — a profile's picked hearts, shown next to pronouns.
-#
-# Locals:
-#   hearts — array of canonical heart names (e.g. profile.heart_emojis)
.heart-display__grid
  - hearts.each do |heart|
    .heart-display__heart
      = image_tag HeartEmoji.image_path(heart), width: 24, height: 24, alt: HeartEmoji.display_name(heart), title: HeartEmoji.display_name(heart), loading: "lazy"
