- journal_page "Post an entry"
- has_problem = @problem.present? || @form.errors.any?
- described_by = ("entry-problem" if has_problem && @problem != :key_rejected)
- chosen_icon_url = @icons.to_h[@form.icon] || (@default_icon_url if @form.icon.blank?)

-# One form in one pane, in the order Dreamwidth's posting page uses
-# (docs/plan-journal.md, "The Write page"). It works without JavaScript; with
-# it, the icon image follows the icon chosen.
= form_with model: @form, scope: :entry, url: journal_dw_entries_path(@connection), method: :post,
  class: "journal-write", data: { controller: "journal-icon-preview journal-draft",
  "journal-draft-key-value": journal_draft_key } do |form|
  = form.hidden_field :datetime_original

  -# Above the pane, like flash messages: what went wrong posting, and the
  -# offer of a draft from before (shown by journal_draft_controller.js).
  = render "journal/entries/problem", problem: @problem, message: @problem_message, form: @form
  .flash.flash--notice.journal-draft-offer{hidden: true, data: { "journal-draft-target": "offer" }}
    %p
      You have an unsent draft from
      = succeed "." do
        %span{data: { "journal-draft-target": "offerTime" }}
    .journal-actions
      %button.btn{type: "button", data: { action: "journal-draft#restore" }} Restore it
      %button.btn.btn--secondary{type: "button", data: { action: "journal-draft#discard" }} Discard it

  .card
    .card__header
      %h1 Post an entry

    .journal-details
      .journal-details__icon{data: { "journal-icon-preview-target": "box" }}
        %img.journal-details__icon-image{src: chosen_icon_url, alt: "", width: 100, height: 100,
          hidden: chosen_icon_url.blank?, data: { "journal-icon-preview-target": "image",
          action: "load->journal-icon-preview#loaded error->journal-icon-preview#loaded" }}
        .journal-details__spinner{hidden: true, data: { "journal-icon-preview-target": "spinner" }}

      .journal-details__fields
        .journal-details__row
          %span.journal-details__label Post as
          %span= dreamwidth_journal_link(@connection.username)
        .journal-details__row
          %label.journal-details__label{for: "entry_post_to"} Post to
          -# Only the journal itself until communities come (with private-only
          -# mode off), so it has no name and isn't sent; it's here to show
          -# where communities will be.
          .journal-details__field
            %select#entry_post_to{aria: { describedby: "post-to-hint" }}
              %option= @connection.username
            %p.form-hint#post-to-hint
              Posting to communities will come later, once Dreamwidth has updated their API.
        %fieldset.journal-details__row.journal-details__date
          %legend.journal-details__label Date
          = render "shared/datetime_picker", form: form, field: :datetime, value: @form.datetime_value
        .journal-details__row
          = form.label :icon, "Icon", class: "journal-details__label"
          = form.select :icon, journal_icon_options(@icons, @default_icon_url, @form.icon), {},
            data: { "journal-icon-preview-target": "select", action: "journal-icon-preview#update" }

    .form-group
      = form.label :subject, "Subject"
      = form.text_field :subject, maxlength: 255, autocomplete: "off", data: { "1p-ignore": "true" }
    .form-group
      = form.label :body, "Entry text"
      = form.text_area :body, rows: 25, required: true, class: "journal-write__text",
        aria: { describedby: ["entry-text-hint", described_by].compact.join(" ") }
      %p.form-hint#entry-text-hint
        HTML tags work here, and a blank line starts a new paragraph, as on Dreamwidth.
      -# "Autosaved draft at 20:22", only seen; the announcement after Ctrl+S is
      -# separate, so autosaving doesn't keep interrupting a screen reader.
      %p.form-hint.journal-draft-status{data: { "journal-draft-target": "status" }}
      %p.visually-hidden{aria: { live: "polite" }, data: { "journal-draft-target": "announce" }}

    .form-group
      = form.label :tags, "Tags"
      -# The journal's tags come with the page, so suggestions appear as soon
      -# as something's typed (journal_tags_controller.js).
      .journal-tags{data: { controller: "journal-tags" }}
        = form.text_field :tags, autocomplete: "off", spellcheck: false,
          aria: { describedby: ["tags-hint", described_by].compact.join(" ") },
          data: { "1p-ignore": "true", "journal-tags-target": "field" }
        = journal_tags_json_tag(@tags)
      %p.form-hint#tags-hint
        Separate tags with commas. Each tag can be up to #{Journal::EntryForm::MAX_TAG_LENGTH} characters.

    .form-group
      = form.label :security, "Show this entry to"
      = form.select :security, Journal::EntryForm.security_options.invert, {},
        aria: { describedby: ("security-hint" if Journal::PRIVATE_ONLY) }
      - if Journal::PRIVATE_ONLY
        %p.form-hint#security-hint
          More options, including custom filters, once Dreamwidth has updated their API.
    .form-group.journal-actions
      = form.submit "Post to: #{@connection.username}"
      = link_to "Back to #{@connection.username}'s entries", journal_dw_entries_path(@connection), class: "btn btn--secondary"
