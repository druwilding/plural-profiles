- subject = @entry&.subject.presence
- journal_page(subject ? "#{subject} — #{@connection.username}" : "Entry in #{@connection.username}")

.card
  .card__header
    %h1 Entry in #{@connection.username}
  = render "journal/shared/flash"
  = render "journal/entries/problem", problem: @problem, message: nil, form: nil

  - if @entry
    -# Read back from Dreamwidth, so this is what it actually saved.
    %p= dreamwidth_entry_visibility(@entry.security)
    %p
      The entry was posted with the following subject:
      %strong= subject || "(no subject)"

  %p From here you can:
  %ul.journal-next-steps
    - if @entry&.url.present?
      %li
        = dreamwidth_link_to(@entry.url) { "View this entry on Dreamwidth" }
    %li
      = dreamwidth_link_to(dreamwidth_journal_url(@connection.username)) { "View #{@connection.username}'s journal on Dreamwidth" }
    %li= link_to "Back to #{@connection.username}'s entries", journal_dw_entries_path(@connection)
    %li= link_to "Post another entry", journal_dw_new_entry_path(@connection)
