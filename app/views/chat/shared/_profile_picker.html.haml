- # Searchable "post as" picker (profile or group) for a plain form field —
- # same look and search behavior as the composer's identity switcher, but
- # fills in two hidden fields instead of firing an immediate PATCH. Usage:
- #   = render "chat/shared/profile_picker", field_name: "chat_server[default_postable]",
- #       label_id: "chat_server_default_postable_label",
- #       profiles: Current.user.profiles.order_by_name_and_labels, groups: Current.user.groups.order_by_name_and_labels,
- #       selected_postable: profiles.first
- # Fills a "_type" and "_id" field derived from field_name — pair with a
- # plain %label{id: label_id} (no `for`) rather than label_tag, since the
- # trigger is a <summary>, not a labelable form control, so a `for` pointing
- # at it (or at the hidden fields) would silently do nothing.
- selected_postable ||= nil
- groups ||= []
- # A bracketed Rails param name (e.g. "chat_server[default_postable]") needs
- # the suffix inserted BEFORE the closing bracket ("chat_server[default_postable_type]") —
- # appending it after the bracket instead (a bug this once shipped with)
- # produces "chat_server[default_postable]_type", which Rack parses as
- # params[:chat_server][:default_postable][:_type], not the flat
- # params[:chat_server][:default_postable_type] the controller reads. A
- # bare field_name (e.g. "default_postable", used by the join form) has no
- # bracket to worry about, so plain concatenation is correct for it as-is.
- type_field_name = field_name.end_with?("]") ? field_name.sub(/\]\z/, "_type]") : "#{field_name}_type"
- id_field_name = field_name.end_with?("]") ? field_name.sub(/\]\z/, "_id]") : "#{field_name}_id"
%details.action-dropdown.profile-picker{data: {controller: "dropdown profile-picker"}}
  = hidden_field_tag type_field_name, selected_postable&.class&.name, data: {"profile-picker-target": "hiddenTypeField"}
  = hidden_field_tag id_field_name, selected_postable&.id, data: {"profile-picker-target": "hiddenField"}
  %summary.profile-picker__trigger{"aria-labelledby": label_id}
    %span.profile-picker__trigger-avatar{data: {"profile-picker-target": "triggerAvatar"}}
      - if selected_postable
        = render "chat/shared/avatar", record: selected_postable, size: 22, shape: "circle"
    %span
      %strong{data: {"profile-picker-target": "triggerName"}}= selected_postable ? formatted_inline(selected_postable.chat_name) : "Choose a profile or group…"
      - selected_pronouns = selected_postable.respond_to?(:chat_pronouns) ? selected_postable.chat_pronouns : nil
      %span.profile-picker__trigger-pronouns{data: {"profile-picker-target": "triggerPronouns"}, hidden: selected_pronouns.blank?}= selected_pronouns.presence && formatted_inline(selected_pronouns)
  .action-dropdown__menu.profile-picker__menu{data: {controller: "profile-filter"}}
    %input.profile-picker__search{type: "text", autocomplete: "off", placeholder: "Find a profile or group…", "aria-label": "Filter profiles and groups", data: {"profile-filter-target": "input", action: "input->profile-filter#apply"}}
    .profile-picker__options
      - if profiles.any?
        %p.profile-picker__group-label Profiles
        - profiles.each do |profile|
          = render "chat/shared/profile_picker_option", postable: profile, selected_postable: selected_postable
      - if groups.any?
        %p.profile-picker__group-label Groups
        - groups.each do |group|
          = render "chat/shared/profile_picker_option", postable: group, selected_postable: selected_postable
      %p.profile-picker__empty{data: {"profile-filter-target": "empty"}, hidden: true} No profiles or groups match your search.
