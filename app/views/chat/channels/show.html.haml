- content_for(:title) { "# #{plain_field(@channel.name)} — #{@server.name} — Plural Profiles" }

.chat-channel{data: {controller: "chat-scroll channel-read", action: "composer:sent->chat-scroll#follow", "channel-read-url-value": mark_read_chat_server_channel_path(@server, @channel)}}
  .chat-channel-header
    .chat-channel-header__title
      = link_to chat_server_path(@server), class: "chat-channel-back", "aria-label": "Back to channels" do
        %span{"aria-hidden": "true"} ‹
      .chat-channel-header__title-column
        -# All on one line, so the header takes as little height from the
        -# messages as it can. The name wraps rather than being cut short; the
        -# subtitle and description give way to it, and "more" shows them in
        -# full (truncated_text_controller.js).
        .chat-channel-header__title-text{data: {controller: "truncated-text", "truncated-text-expanded-class": "chat-channel-header__title-text--expanded"}}
          %h1= safe_join([ "# ", formatted_inline(@channel.name) ])
          - if @channel.subtitle.present?
            %p.subtitle{title: plain_field(@channel.subtitle), data: {"truncated-text-target": "text"}}= formatted_inline(@channel.subtitle)
          - if @channel.description.present?
            %p.description{title: plain_field(@channel.description), data: {"truncated-text-target": "text"}}= formatted_inline(@channel.description)
          - if @channel.subtitle.present? || @channel.description.present?
            %button.link-button.chat-channel-header__more{type: "button", hidden: true, "aria-expanded": "false", data: {"truncated-text-target": "toggle", action: "truncated-text#toggle"}}
              %span{data: {"truncated-text-target": "label"}} more
              %span.visually-hidden of the channel details

    - if server_owner?
      = link_to "Channel settings", edit_chat_server_channel_path(@server, @channel), class: "btn btn--secondary btn--small"

  = turbo_stream_from @channel

  .chat-messages-scroll{data: {"chat-scroll-target": "scrollable"}}
    #chat-messages.chat-messages{data: {"chat-scroll-target": "messages"}}
      - if @has_more_messages
        %turbo-frame#older-messages{src: chat_server_channel_messages_path(@server, @channel, before_id: @messages.first.id, before_created_at: @messages.first.created_at.iso8601(6)), loading: "lazy"}
      - if @messages.any?
        = render "chat/messages/message_list", messages: @messages
      - else
        %p.chat-messages__empty No messages yet. Say hello!

  .composer{data: {controller: "composer"}}
    - if current_membership&.default_postable
      - current_postable = @channel.default_postable_for(Current.user) || current_membership.default_postable
      = render "chat/channels/posting_as_picker", server: @server, channel: @channel, current_postable: current_postable

    = form_with model: @message, url: chat_server_channel_messages_path(@server, @channel), scope: :chat_message, data: { "composer-target": "form", action: "submit->composer#submitting turbo:submit-start->composer#sending turbo:submit-end->composer#sent" } do |form|
      - if @message.errors.any?
        .error-messages
          - @message.errors.full_messages.each do |message|
            %p= message

      .composer-input-row
        = emote_field(form, :body, as: :text_area, menu_placement: "above", rows: 1, required: true, autofocus: true, placeholder: "Message ##{plain_field(@channel.name)} (Enter to send, Shift+Enter for a new line)", data: { "composer-target": "textarea", "draft-key": "#{Current.user.id}:#{@channel.uuid}", "draft-sent": (flash[:sent_message_in] == @channel.uuid).to_s, action: "keydown->composer#submitOnEnter input->composer#detectProxy input->composer#autoGrow input->composer#saveDraft" })
        %button.composer-send{type: "submit", title: "Send", data: { "composer-target": "send" }}
          = render "chat/channels/send_icon"
          %span.visually-hidden Send
