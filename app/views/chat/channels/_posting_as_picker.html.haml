- # The composer's "Posting as" identity switcher — its own partial (rather
- # than inline in show.html.haml) so Chat::ChannelDefaultPostablesController#update
- # can turbo_stream-replace just this node after switching who's posting,
- # instead of redirecting (which would force a full-page Turbo visit and wipe
- # out whatever the user had typed into the message textarea below it).
- current_pronouns = current_postable.respond_to?(:chat_pronouns) ? current_postable.chat_pronouns : nil
%details#posting-as-picker.action-dropdown.profile-picker.composer-posting-as{data: {controller: "dropdown"}}
  %summary.profile-picker__trigger
    %span.profile-picker__trigger-avatar{data: {"composer-target": "triggerAvatar"}}
      = render "chat/shared/avatar", record: current_postable, size: 22, shape: "circle"
    %span
      Posting as
      %strong{data: {"composer-target": "triggerName"}}= formatted_inline(current_postable.chat_name)
      %span.profile-picker__trigger-pronouns{data: {"composer-target": "triggerPronouns"}, hidden: current_pronouns.blank?}= current_pronouns.presence && formatted_inline(current_pronouns)
  .action-dropdown__menu.profile-picker__menu{data: {controller: "profile-filter"}}
    %input.profile-picker__search{type: "text", autocomplete: "off", placeholder: "Find a profile or group…", "aria-label": "Filter profiles and groups", data: {"profile-filter-target": "input", action: "input->profile-filter#apply"}}
    .profile-picker__options
      - profiles = Current.user.profiles.order_by_position_then_name.includes(avatar_attachment: :blob)
      - groups = Current.user.groups.order_by_position_then_name.includes(avatar_attachment: :blob)
      - if profiles.any?
        %p.profile-picker__group-label Profiles
        - profiles.each do |profile|
          = render "chat/channels/posting_as_option", postable: profile, current_postable: current_postable, server: server, channel: channel
      - if groups.any?
        %p.profile-picker__group-label Groups
        - groups.each do |group|
          = render "chat/channels/posting_as_option", postable: group, current_postable: current_postable, server: server, channel: channel
      %p.profile-picker__empty{data: {"profile-filter-target": "empty"}, hidden: true} No profiles or groups match your search.
