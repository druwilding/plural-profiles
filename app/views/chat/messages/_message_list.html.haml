-# Locals:
-#   messages — an array/relation of Chat::Message, already in ascending
-#              (oldest-first) order
-#
-# Inserts a date divider before the first message of each calendar day
-# within this list. Each rendering context (the initial page load, and each
-# lazily-loaded older batch) computes its own dividers independently, since
-# they're separate requests with no shared state. A live-broadcast message
-# that's the first of a new day gets its divider in the browser instead
-# (chat_dates_controller.js), since a broadcast can't know the viewer's day.
- previous_date = nil
- messages.each do |message|
  - message_date = message.created_at.to_date
  - if message_date != previous_date
    = render "chat/shared/date_divider", date: message_date
    - previous_date = message_date
  = render "chat/messages/message", message: message
