- content_for(:container_class) { "narrow" }
- content_for(:title) { "Sign in — Plural Profiles" }

.card
  .card__header
    %h1 Sign in

  -# Not submitted by Turbo: after signing in, someone sent here from a chat
  -# page goes back to it on the chat. subdomain, and Turbo's fetch can't
  -# follow a redirect to another origin (this app sets up no CORS). It fails,
  -# and Turbo reloads this page, so they're signed in but stuck here. A plain
  -# form submission is a top-level navigation, which can go anywhere. The
  -# chat's sign-out button is the same, the other way round
  -# (layouts/chat.html.haml).
  = form_with url: session_path, data: { turbo: false } do |form|
    .form-group
      = form.label :login, "Email address or account name"
      = form.text_field :login, required: true, autocomplete: "username", value: params[:login]

    .form-group
      = form.label :password
      = form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72

    .form-group
      = form.submit "Sign in"

  .form-links
    %p= link_to "Forgot password?", new_password_path
    %p
      Don't have an account?
      = link_to "Sign up", new_registration_path

= render "shared/about"
